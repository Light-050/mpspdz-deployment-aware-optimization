from Compiler.types import sint
from Compiler.library import print_ln
a = sint.Array(8000)
b = sint.Array(8000)
for i in range(8000):
    a[i] = sint(i + 1)
    b[i] = sint(i + 1)
results = sint.Array(160)
for batch in range(160):
    start = batch * 50
    results[batch] = sint.dot_product(a.get_range(start, 50), b.get_range(start, 50))
print_ln("done: %s", results[159].reveal())
