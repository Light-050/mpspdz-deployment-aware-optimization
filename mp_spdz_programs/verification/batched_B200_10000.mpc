from Compiler.types import sint
from Compiler.library import print_ln

a = sint.Array(10000)
b = sint.Array(10000)

for i in range(10000):
    a[i] = sint(i + 1)
    b[i] = sint(i + 1)

results = sint.Array(50)
for batch in range(50):
    start = batch * 200
    a_b = a.get_range(start, 200)
    b_b = b.get_range(start, 200)
    results[batch] = sint.dot_product(a_b, b_b)

print_ln("done: %s", results[49].reveal())
